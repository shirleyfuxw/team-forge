#!/usr/bin/env bash
# team-forge session-start hook — slim, just announces availability.
#
# Outputs an additionalContext informing the model team-forge is installed
# and what its entry points are. No enforcement bravado.
#
# Keep this list honest: it once advertised six skills (brainstorming,
# writing-plans, forge, rehydrate, tracker, monitor) that had all been retired,
# so every session started by being told to invoke things that did not exist.

set -euo pipefail

message='team-forge extension is installed.

Available skills:
  - team-forge:goal       (start here — interrogate the problem, write docs/team-forge/<team>/contract.yaml
                           with a runnable check per done_when and no steps, hand the user a /goal line,
                           then route: direct-execution or machinery)
  - team-forge:design     (machinery route only — archetype triage, roster/tasks/gates, skill gaps → design.yaml)
  - team-forge:run        (the shared runtime for every forged team/workflow — all lead policy lives here,
                           so it updates with the plugin instead of going stale in your repo)
  - team-forge:evolve     (at each cycle end and once at close — mine the ledger and agent MEMORY.md files
                           into docs/team-forge/<team>/lessons.md; only evidence-backed lessons are applied)
  - team-forge:teardown   (retire a finished team: archive the ledger, prune worktrees, remove the launcher,
                           classify every forged file as durable or ephemeral)

Emission is a script, not a skill:
  python3 <team-forge>/tools/forge.py <hub>/design.yaml            # forge from a design
  python3 <team-forge>/tools/forge.py <hub>/design.yaml --check    # template + design staleness
  python3 <team-forge>/tools/forge.py <hub>/design.yaml --resync   # land it, preserving live state

Start any non-trivial ask with team-forge:goal. To launch an already-forged team, invoke
/<team>-workflow or /<team>-team; a workflow lead with persistent memory across runs is
claude --agent <team>-lead.

CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 is required only for the persistent-roster team archetype.
The workflow archetype does not need it.'

# Escape for JSON
escaped=$(printf '%s' "$message" | python3 -c 'import json, sys; print(json.dumps(sys.stdin.read()))')

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"additionalContext":%s}}\n' "$escaped"
else
  printf '{"additional_context":%s}\n' "$escaped"
fi
